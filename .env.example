# LiveKit Cloud (https://livekit.io/cloud) - free tier
# Project settings -> Keys -> copy the key/secret pair, and the URL like wss://<project>.livekit.cloud
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=APIxxxx
LIVEKIT_API_SECRET=your_secret

# Deepgram (https://deepgram.com) - new accounts get $200 free credit, no card
DEEPGRAM_API_KEY=your_deepgram_key
DEEPGRAM_MODEL=nova-3

# Groq (https://console.groq.com/keys) - free tier
GROQ_API_KEY=gsk_your_groq_key
GROQ_MODEL=llama-3.3-70b-versatile

# Cartesia (https://cartesia.ai/cartesian/keys or Console) - free tier
CARTESIA_API_KEY=your_cartesia_key
# A Sonic-3 voice id (this one is LiveKit's default Cartesia voice)
CARTESIA_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc

# Optional: name the worker's agent (blank = automatic dispatch, recommended for dev)
AGENT_NAME=

# --- Conversation quality knobs (all optional) ---
# LLM warmth (higher = more varied/informal). Default 0.8.
LLM_TEMPERATURE=0.8
# Deepgram ASR language, default en-US. See DeepgramLanguages for valid codes.
STT_LANGUAGE=en-US
# Comma-separated vocabulary boost for names/domain terms (e.g. "Acme,Zeek,Ganymede-7")
# STT_KEYTERMS=
# Sonic-3 is expressive: a rich free-form emotion descriptor (string) beats a flat
# label, e.g. "curious, warm and friendly, light and conversational". Unset = default.
# CARTESIA_EMOTION=
# Sonic-3 speech rate, valid range 0.6 - 2.0. ~0.94 reads more natural/human.
# CARTESIA_SPEED=0.94

# --- QA / latency logging (all optional) ---
# Log verbosity: DEBUG, INFO, WARNING. Default INFO. Internals stay at WARNING unless DEBUG.
LOG_LEVEL=INFO
# Append logs to this file (default: terminal only). e.g. logs/agent.log
LOG_FILE=logs/agent.log
# Print an aggregate latency summary every N turns (0 disables). Default 10.
LOG_SUMMARY_EVERY=10