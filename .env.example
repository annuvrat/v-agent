# LiveKit Cloud (https://livekit.io/cloud) - free tier
# Project settings -> Keys -> copy the key/secret pair, and the URL like wss://<project>.livekit.cloud
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=APIxxxx
LIVEKIT_API_SECRET=your_secret

# STT/TTS providers. Defaults to Sarvam for both; set to deepgram/cartesia to
# revert to the previous stack.
# STT_PROVIDER=sarvam
# TTS_PROVIDER=sarvam

# Sarvam (https://sarvam.ai/dashboard) - Indian-language STT/TTS (default)
SARVAM_API_KEY=your_sarvam_key
# Sarvam uses BCP-47 codes: en-IN, hi-IN, bn-IN, ta-IN, te-IN, ...
SARVAM_LANGUAGE=en-IN
# TTS model + voice (bulbul:v3 female voices: suhani, rupali, tanya, shruti,
# kavitha, priya, neha; male: shubh, rahul, amit, ...)
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_VOICE=suhani
# Speech rate multiplier (0.3 - 3.0). Mia overrides this per turn from your
# wording, so this is just the baseline.
SARVAM_TTS_PACE=1.0
# linear16 = raw PCM, lowest latency/CPU. mp3/wav/opus/flac/aac also accepted.
SARVAM_TTS_CODEC=linear16
SARVAM_TTS_SAMPLE_RATE=22050
# STT model + mode (saaras:v3/saaras:v4; transcribe/translate/verbatim/translit/codemix)
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_MODE=transcribe

# Deepgram (https://deepgram.com) - new accounts get $200 free credit, no card
DEEPGRAM_API_KEY=your_deepgram_key
DEEPGRAM_MODEL=nova-3

# Groq (https://console.groq.com/keys) - free tier
GROQ_API_KEY=gsk_your_groq_key
GROQ_MODEL=llama-3.3-70b-versatile

# Cartesia (https://cartesia.ai/cartesian/keys or Console) - free tier
CARTESIA_API_KEY=your_cartesia_key
# A Sonic-3 voice id (this one is LiveKit's default Cartesia voice)
CARTESIA_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc

# Tavily (https://tavily.com) - free tier ~1000 searches/mo. Enables live web
# search via Mia's web_search tool. If unset, Mia politely says search is off.
# TAVILY_API_KEY=tvly-... 

# Optional: name the worker's agent (blank = automatic dispatch, recommended for dev)
AGENT_NAME=

# --- Conversation quality knobs (all optional) ---
# LLM warmth (higher = more varied/informal). Default 0.8.
LLM_TEMPERATURE=0.8
# Deepgram ASR language, default en-US. Only used when STT_PROVIDER=deepgram.
# (Sarvam uses SARVAM_LANGUAGE instead.)
STT_LANGUAGE=en-US
# Comma-separated vocabulary boost for names/domain terms (Deepgram only).
# STT_KEYTERMS=
# Sonic-3 is expressive: a rich free-form emotion descriptor (string) beats a flat
# label, e.g. "curious, warm and friendly, light and conversational". Unset = default.
# Only used when TTS_PROVIDER=cartesia (Sarvam adjusts `pace` instead).
# CARTESIA_EMOTION=
# Sonic-3 speech rate, valid range 0.6 - 2.0. ~0.94 reads more natural/human.
# Only used when TTS_PROVIDER=cartesia.
# CARTESIA_SPEED=0.94

# --- QA / latency logging (all optional) ---
# Log verbosity: DEBUG, INFO, WARNING. Default INFO. Internals stay at WARNING unless DEBUG.
LOG_LEVEL=INFO
# Append logs to this file (default: terminal only). e.g. logs/agent.log
LOG_FILE=logs/agent.log
# Print an aggregate latency summary every N turns (0 disables). Default 10.
LOG_SUMMARY_EVERY=10